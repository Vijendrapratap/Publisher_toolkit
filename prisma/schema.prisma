generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id                String        @id @default(cuid())
  publisherId       String
  title             String?
  author            String?
  blurb             String?
  pdfUrl            String?
  frontCoverUrl     String?
  backCoverUrl      String?
  sourceUrl         String?
  price             String?
  categories        String[]      @default([])
  bullets           String[]      @default([])
  contentGoal       String?       @default("all")
  interiorImageUrls String[]      @default([])
  rating            Float?
  reviewCount       Int?
  status            String        @default("uploaded")
  platforms         String[]      @default(["META", "GOOGLE", "AMAZON"])
  copyTone          String        @default("literary")
  templateKey       String        @default("classic")
  campaignName      String?       @default("Main Campaign")
  campaignObjective String?       @default("launch")
  targetAudience    String?
  customHook        String?
  ctaText           String?       @default("Order Your Copy Today")
  includeVideo      Boolean       @default(true)
  videoFormat       String?       @default("16:9")
  videoStyle        String?       @default("cinematic")
  videoMood         String?       @default("suspenseful")
  videoLength       String?       @default("30s")
  videoSpec         Json?
  aiVideoBrief      Json?
  parentBookId      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  creativeSets      CreativeSet[]
  aiVideoJobs       AiVideoJob[]

  @@index([publisherId])
  @@index([parentBookId])
}

model CreativeSet {
  id                String          @id @default(cuid())
  bookId            String
  book              Book            @relation(fields: [bookId], references: [id])
  campaignName      String?
  campaignObjective String?
  templateKey       String?
  videoUrl          String?
  videoPosterUrl    String?
  videoDuration     Int?
  createdAt         DateTime        @default(now())
  adCopies          AdCopy[]
  images            CreativeImage[]

  @@index([bookId])
}

model AdCopy {
  id            String      @id @default(cuid())
  creativeSetId String
  creativeSet   CreativeSet @relation(fields: [creativeSetId], references: [id])
  platform      String
  headline      String
  primaryText   String
  description   String

  @@index([creativeSetId])
}

model CreativeImage {
  id            String      @id @default(cuid())
  creativeSetId String
  creativeSet   CreativeSet @relation(fields: [creativeSetId], references: [id])
  platform      String
  sizeKey       String
  width         Int
  height        Int
  imageUrl      String

  @@index([creativeSetId])
}

model TrailerProject {
  id                String             @id @default(cuid())
  publisherId       String
  title             String?
  author            String?
  blurb             String?
  pdfUrl            String?
  frontCoverUrl     String?
  backCoverUrl      String?
  sourceUrl         String?
  interiorImageUrls String[]           @default([])
  status            String             @default("uploaded")
  length            String             @default("15s")
  style             String             @default("cinematic")
  musicMood         String             @default("suspenseful")
  aspectRatios      String[]           @default(["9:16", "1:1", "16:9"])
  hookText          String?
  ctaText           String?            @default("AVAILABLE NOW • GET YOUR COPY TODAY")
  adPreset          String             @default("trade")
  adHeadline        String?
  adBenefits        String[]           @default([])
  aiScene           Boolean            @default(false)
  showProof         Boolean            @default(true)
  rating            Float?
  reviewCount       Int?
  price             String?
  categories        String[]           @default([])
  bullets           String[]           @default([])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  trailers          GeneratedTrailer[]

  @@index([publisherId])
}

model GeneratedTrailer {
  id          String         @id @default(cuid())
  projectId   String
  project     TrailerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aspectRatio String
  preset      String         @default("trade")
  videoUrl    String
  posterUrl   String
  duration    Int            @default(30)
  width       Int
  height      Int
  createdAt   DateTime       @default(now())

  @@index([projectId])
}

model AudiobookProject {
  id             String             @id @default(cuid())
  publisherId    String
  title          String?
  author         String?
  blurb          String?
  pdfUrl         String?
  coverUrl       String?
  status         String             @default("uploaded")
  ttsProvider    String             @default("fishaudio")
  voiceModel     String             @default("warm-literary")
  voicePacing    Float              @default(1.0)
  audioFormat    String             @default("mp3")
  sampleAudioUrl String?
  totalDuration  Int                @default(0)
  fullAudioUrl   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  chapters       AudiobookChapter[]

  @@index([publisherId])
}

model AudiobookChapter {
  id            String           @id @default(cuid())
  projectId     String
  project       AudiobookProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterNumber Int
  title         String
  content       String           @db.Text
  audioUrl      String?
  duration      Int              @default(0)
  status        String           @default("ready")
  createdAt     DateTime         @default(now())

  @@index([projectId])
}

model LandingProject {
  id                 String   @id @default(cuid())
  publisherId        String
  title              String?
  subtitle           String?
  author             String?
  authorBio          String?  @db.Text
  synopsis           String?  @db.Text
  coverUrl           String?
  status             String   @default("uploaded")
  template           String   @default("bestseller")
  theme              String   @default("matt")
  accentColor        String   @default("#6366f1")
  ctaText            String   @default("Order Your Copy Today")
  retailerLinks      Json?
  reviews            Json?
  sampleChapterTitle String?
  sampleChapterText  String?  @db.Text
  publishedSlug      String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([publisherId])
}

model BookCreatorProject {
  id              String   @id @default(cuid())
  publisherId     String
  title           String?
  subtitle        String?
  author          String?
  bookType        String   @default("children")
  genre           String?
  targetAudience  String?
  styleTheme      String?
  difficultyLevel String?
  promptConcept   String?  @db.Text
  coverPrompt     String?  @db.Text
  coverImageUrl   String?
  status          String   @default("draft")
  metadata        Json?
  content         Json?
  wordCount       Int      @default(0)
  pageCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([publisherId])
}

/// Only one active (running/stitching) job per book is allowed: enforced by a
/// partial unique index in migration 20260923140000_ai_video_one_active.
/// Prisma's schema language can't express a partial index, so it lives in
/// that migration's raw SQL only — not here.
model AiVideoJob {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status    String   @default("running")
  model     String
  format    String
  brief     Json
  shots     Json
  videoUrl  String?
  posterUrl String?
  error     String?
  costUsd   Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
}
